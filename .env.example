# --- Odoo bridge (server-only). Jangan pernah prefix NEXT_PUBLIC_. ---
# Contoh: https://namadomainanda.odoo.com
ODOO_URL=
# Nama database Odoo (mis. nama-db-lokalmart-produksi)
ODOO_DB=
# Internal bot / service user — BUKAN user pribadi
ODOO_USERNAME=
# Password atau JSON-2 API key milik bot
ODOO_PASSWORD=
# xmlrpc (default, trial/online) atau json2 (Odoo 18+)
ODOO_API_MODE=xmlrpc

# Company LokalMart di Odoo (LokalMart = id 1 di edu-lokalmart.odoo.com)
ODOO_COMPANY_ID=1
# Aktifkan penulisan sale.order/partner dari web (true/false)
ODOO_WRITES=true
# Baca stok & validasi produk langsung dari Odoo (true setelah katalog Odoo siap)
ODOO_ENRICH_CATALOG=false

# --- Identitas toko (boleh public) ---
NEXT_PUBLIC_TOKO_NAMA=LOKALMART
NEXT_PUBLIC_TOKO_TAGLINE=Mitra Belanja Keluarga Indonesia
NEXT_PUBLIC_TOKO_ALAMAT=Depan Masjid, Jl. Raya Toko Kelontong No. 88
NEXT_PUBLIC_TOKO_WA=0812-3456-7890
# Nomor WA versi internasional untuk deep link wa.me (tanpa + dan tanpa spasi)
NEXT_PUBLIC_TOKO_WA_LINK=6281234567890
# Jam operasional (ditampilkan apa adanya)
NEXT_PUBLIC_TOKO_JAM=Senin–Sabtu 07.00–21.00 WIB · Minggu 07.00–12.00 WIB

# Harga katalog & promo promo mingguan bersumber dari lib/seed-products.ts
# (file itu adalah "DAFTAR HARGA PROMO MINGGUAN" yang sama dengan template PDF).
